{
  "name": "cyon-connect",
  "version": "0.0.0",
  "private": true,
  "description": "CYON Connect web and backend platform (Sprint 0 foundation)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run arch:check && npm run test && npm run build && npm run security:bundle-scan && npm run secrets:scan",
    "arch:check": "depcruise app modules shared infrastructure components scripts --config .dependency-cruiser.cjs --ts-config tsconfig.json",
    "database:migrate": "tsx scripts/database/run.ts migrate",
    "database:reset": "tsx scripts/database/run.ts reset",
    "database:seed": "tsx scripts/database/run.ts seed",
    "secrets:scan": "tsx scripts/security/scan-secrets.ts",
    "security:bundle-scan": "tsx scripts/security/scan-client-bundle.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.3.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
