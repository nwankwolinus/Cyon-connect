# CYON Connect environment template. Copy to .env.local and fill in. NEVER commit real values.
# .env, .env.local and every .env.* except this file are gitignored.

# --- Deployment identity (server-only) ---
# development | test | staging | production. Set explicitly in hosted deployments.
# Netlify staging must use APP_ENV=staging; never use development to enable staging workflows.
# Destructive database scripts separately refuse staging and production.
APP_ENV=development
# Applicant registration defaults off. In staging, it requires the exact security-test Supabase target.
APPLICANT_REGISTRATION_ENABLED=false
# Membership intake defaults off. In staging, it requires the exact security-test Supabase target
# and a parish UUID verified in that project.
MEMBERSHIP_APPLICATION_SUBMISSION_ENABLED=false
# Server-only HMAC key for the scheduled Storage photo cleanup endpoint (at least 32 random bytes, base64url).
MEMBERSHIP_PHOTO_CLEANUP_HMAC_SECRET=<server-only-cleanup-hmac-secret>
# Server-only active parish UUID; must resolve to SS Joachim and Anne Catholic Church, Ijegun.
CYON_ACTIVE_PARISH_ID=<verified-development-parish-uuid>

# --- Public client configuration (safe to expose to browsers/mobile; must start with NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Development must use the dedicated CYON security-test Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://crfcglxcsnmeovnipnko.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<development-project-publishable-key>
# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never import in client code) ---
SUPABASE_SERVICE_ROLE_KEY=<development-project-server-only-key>
# --- Local database tooling only (used by `npm run database:seed`; local database only) ---
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
