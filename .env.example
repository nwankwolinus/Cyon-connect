# CYON Connect environment template. Copy to .env.local and fill in. NEVER commit real values.
# .env, .env.local and every .env.* except this file are gitignored.

# --- Deployment identity (server-only) ---
# development | test | staging | production. REQUIRED for destructive database scripts,
# which refuse anything other than development/test (and always refuse production).
APP_ENV=development

# --- Public client configuration (safe to expose to browsers/mobile; must start with NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never import in client code) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
# --- Local database tooling only (used by `npm run database:seed`; local database only) ---
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
