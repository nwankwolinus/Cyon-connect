# CYON Connect environment template. Copy to .env.local and fill in. NEVER commit real values.

# --- Deployment / development ---
# development | test | production
NODE_ENV=development
# Public base URL of the web app (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase: public client configuration (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# --- Supabase: server-only secrets (NEVER prefix with NEXT_PUBLIC_, never import in client code) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
